# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.sh,hv}]
indent_style = tab
indent_size = 4

[{Caddyfile,*.caddy,Dockerfile}]
indent_style = tab
indent_size = 4

[{*.go,go.mod}]
indent_style = tab
indent_size = 4

[*.php]
indent_style = tab
indent_size = 4

[{*.ps1,*.psm1,*.psd1}]
end_of_line = crlf
charset = utf-8-bom
indent_size = 4

[{*.cmd,*.bat}]
end_of_line = crlf

# Android (android/)
[{*.kt,*.kts,*.xml,*.properties}]
indent_size = 4

[gradlew]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
