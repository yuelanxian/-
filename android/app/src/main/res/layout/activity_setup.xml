<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hv_toolbar">

        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:popupTheme="@style/ThemeOverlay.HomeVault.Popup"
            android:theme="@android:style/ThemeOverlay.Material.Dark.ActionBar"
            android:title="@string/setup_title"
            android:titleTextColor="@color/hv_on_toolbar" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/setup_intro"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/hv_text_secondary" />

            <TextView
                android:id="@+id/panel_url_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_panel_label"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <EditText
                android:id="@+id/panel_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_panel_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/nextcloud_url_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_nextcloud_label"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <EditText
                android:id="@+id/nextcloud_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_nextcloud_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.2"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <Button
                android:id="@+id/save_button"
                style="@android:style/Widget.Material.Button.Colored"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_save" />

            <Button
                android:id="@+id/test_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_test" />

            <Button
                android:id="@+id/cert_help_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_cert_help" />

            <Button
                android:id="@+id/vpn_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_open_vpn" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
