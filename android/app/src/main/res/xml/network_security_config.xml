<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. Trust anchors: system CAs (domain mode, real certificates) and
  user-installed CAs (IP mode: the HomeVault / Caddy local root CA that the user
  installs once in Android settings). Certificate errors are never bypassed.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates
                src="user"
                tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
