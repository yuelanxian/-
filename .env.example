# =====================================================================
# HomeVault 配置文件模板
# ---------------------------------------------------------------------
# - 请不要直接修改本文件：安装时 ./hv install（Linux）或 windows\hv.ps1 install
#   会据此生成 .env；之后需要修改时编辑 .env，再运行 ./hv up 让配置生效。
# - 格式：每行 变量名=值。值中含空格时用单引号括起来，例如 'a b'。
# - Windows 路径请用正斜杠，例如 D:/HomeVault/nextcloud-data。
# - 密码等机密信息不放在这里，而是存放在 secrets/ 目录（每个文件一个）。
# =====================================================================

# ---------------------------------------------------------------------
# 基本信息 / 网络
# ---------------------------------------------------------------------
# Docker Compose 项目名（容器、卷名的前缀）
COMPOSE_PROJECT_NAME=homevault
# 运行平台：linux 或 windows
HV_PLATFORM=linux
# 客户端访问服务器使用的地址：IP 模式填局域网 IPv4；域名模式填域名（其公网 A 记录指向局域网 IP）
HV_HOST=192.168.1.10
# 本机局域网 IPv4 地址与网段（安装时自动检测）
HV_LAN_IP=192.168.1.10
HV_LAN_CIDR=192.168.1.0/24
# 额外的访问地址（空格分隔，可填 IP 或域名；一般留空）
HV_EXTRA_HOSTS=
# Caddy 监听的本机 IPv4 地址：Linux 默认为局域网 IP；Windows（Docker Desktop）为 0.0.0.0（由 Windows 防火墙限制）
# 切勿留空或写成 IPv6，否则可能暴露到公网 IPv6
HV_BIND_IP=192.168.1.10
# HTTP 端口（仅用于跳转到 HTTPS）
HV_HTTP_PORT=80
# HTTPS 端口（Nextcloud 访问端口）
HV_HTTPS_PORT=443
# 管理界面端口（wg-easy VPN 管理，仅 Linux 启用 VPN 时使用）
HV_ADMIN_PORT=8443
# 管理面板端口（手机 App / 浏览器访问 https://HV_HOST:9443；同样只允许局域网和 VPN 访问）
HV_PANEL_PORT=9443
# 允许访问的来源网段（Caddy 兜底过滤，Caddy remote_ip 语法；private_ranges = 所有内网地址）
HV_ALLOWED_CIDRS='private_ranges 100.64.0.0/10'
# 容器内部前端网络网段（与家里局域网、VPN 网段都不能冲突）
HV_FRONTEND_SUBNET=172.31.250.0/24
# 时区
HV_TZ=Asia/Shanghai

# ---------------------------------------------------------------------
# 派生变量 —— 由 hv / hv.ps1 在每次 install / up 时自动计算并改写，请勿手工修改
# ---------------------------------------------------------------------
# Caddy 站点地址列表（逗号分隔，含协议与端口），例如 https://192.168.1.10:443, https://10.99.77.1:443
HV_SITE_ADDRESSES=https://192.168.1.10:443
# Nextcloud 可信域名（空格分隔，不含协议；端口不是 443 时同时包含 主机:端口）
HV_TRUSTED_DOMAINS=192.168.1.10
# Nextcloud 命令行生成链接用的地址（https://HV_HOST，端口不是 443 时带 :端口）
HV_OVERWRITE_CLI_URL=https://192.168.1.10
# Caddy 证书片段：internal | acme-alidns | acme-tencentcloud | acme-cloudflare
HV_TLS_SNIPPET=internal
# Caddy 管理界面片段：wgeasy（Linux 且启用 VPN）| none
HV_ADMIN_SNIPPET=none

# ---------------------------------------------------------------------
# HTTPS 证书
# ---------------------------------------------------------------------
# internal = IP 模式，使用 Caddy 本地 CA（需在手机/电脑上安装根证书）
# acme-dns = 域名模式，通过 DNS 验证自动申请 Let's Encrypt 证书（推荐，有域名时使用）
HV_TLS_MODE=internal
# 域名模式的 DNS 服务商：alidns（阿里云）| tencentcloud（腾讯云 DNSPod）| cloudflare
# 对应的 API 密钥保存在 secrets/caddy-dns.env
HV_DNS_PROVIDER=alidns
# 申请证书时登记的邮箱（域名模式使用，可以留空）
HV_ACME_EMAIL=

# ---------------------------------------------------------------------
# 存储位置
# ---------------------------------------------------------------------
# Linux：所有数据的根目录
HV_DATA_DIR=/srv/homevault
# Nextcloud 数据目录在宿主机上的路径（Linux 需属主 33:33、权限 0750；Windows 例如 D:/HomeVault/nextcloud-data）
HV_NC_DATA_PATH=/srv/homevault/nextcloud-data
# 以下各项：填宿主机路径 = 绑定挂载到该目录；留空 = 使用 Docker 命名卷
# （Linux 安装时默认设为 HV_DATA_DIR 下的子目录；Windows 保持留空，数据库不要放在 NTFS 上）
# Nextcloud 程序与配置（/var/www/html）
HV_VOL_HTML=
# PostgreSQL 数据库
HV_VOL_DB=
# Redis 缓存
HV_VOL_REDIS=
# Caddy 数据（证书与本地 CA 根密钥，务必随备份保存）
HV_VOL_CADDY_DATA=
# Caddy 运行配置
HV_VOL_CADDY_CONFIG=
# wg-easy 数据（VPN 配置与密钥，仅 Linux）
HV_VOL_WGEASY=
# 备份前数据库导出（pg_dump）存放目录（宿主机路径）
HV_DUMP_DIR=/srv/homevault/dumps

# ---------------------------------------------------------------------
# 日志（可在管理面板「日志」页、./hv logs 或 Windows 菜单中查看）
# ---------------------------------------------------------------------
# 日志目录（宿主机路径）：Linux 默认为 HV_DATA_DIR/logs；Windows 默认为 <数据盘>:/HomeVault/logs（资源管理器可直接打开）
# 子目录：homevault（管理命令）、backup（备份）、nextcloud（nextcloud.log 与审计日志 audit.log）、
#         caddy（访问日志 access.log）、containers（每天导出的容器日志）、panel（管理面板操作记录）
HV_LOG_DIR=/srv/homevault/logs
# 日志保留天数（1-365，默认 7 天）：每日维护任务删除更早的日志文件。
# 修改：./hv logs retention <天数>、Windows 管理菜单或管理面板「设置」页
HV_LOG_RETENTION_DAYS=7

# ---------------------------------------------------------------------
# Nextcloud
# ---------------------------------------------------------------------
# 管理员用户名（密码在 secrets/nextcloud_admin_password）
HV_ADMIN_USER=hvadmin
# 是否允许创建公开分享链接（默认关闭；开启后强制链接密码）
HV_ALLOW_PUBLIC_LINKS=false
# 用户密码最小长度
HV_PASSWORD_MIN_LENGTH=12
# 默认界面语言
HV_DEFAULT_LANGUAGE=zh_CN
# PHP 内存上限
PHP_MEMORY_LIMIT=1G
# 单个文件上传上限（手机 App 使用分块上传，一般不受此限制）
PHP_UPLOAD_LIMIT=16G
# 后台维护任务开始时间（UTC 小时，18 = 北京时间凌晨 2 点，持续 4 小时）
HV_MAINTENANCE_WINDOW_UTC=18
# 升级后是否执行耗时的 maintenance:repair --include-expensive（大型实例可能需要很久）
HV_REPAIR_EXPENSIVE=false

# ---------------------------------------------------------------------
# VPN（WireGuard）
# ---------------------------------------------------------------------
# 是否启用 VPN：true = 启用（Linux 使用 wg-easy，管理员密码在 secrets/wg_easy_admin_password；
# Windows 使用 WireGuard for Windows）；false = 不启用（只能在家里局域网内访问）
HV_VPN_ENABLED=true
# 手机在外连接家里时使用的地址：DDNS 域名或公网 IP
WG_HOST=
# WireGuard UDP 端口（安装时随机选择 20000-60000；路由器只需转发这个 UDP 端口）
WG_PORT=51820
# VPN 内部网段（不能与局域网或容器网段冲突）
HV_VPN_CIDR=10.99.77.0/24
# VPN 客户端可访问范围：host = 仅本服务器（推荐）；full = 整个家庭局域网
HV_VPN_LAN_ACCESS=host
# VPN 客户端使用的 DNS（逗号分隔）
HV_VPN_DNS=223.5.5.5,119.29.29.29
# 保活间隔（秒）：0 = 关闭（省电）；连接不稳定时改为 25
HV_VPN_KEEPALIVE=0
# Windows：WireGuard 服务端配置目录（用于备份；Linux 留空）
HV_WIN_WG_DIR=

# ---------------------------------------------------------------------
# 动态域名（DDNS，可选）
# ---------------------------------------------------------------------
# 是否启用 ddns-go（配置与密钥在 secrets/ddns-go.yaml，由 hv ddns setup 生成）
HV_DDNS_ENABLED=false
# DNS 服务商：alidns | tencentcloud | cloudflare 等
HV_DDNS_PROVIDER=alidns
# 要自动更新的域名，例如 home.example.com
HV_DDNS_DOMAIN=

# ---------------------------------------------------------------------
# 备份（restic，加密；密码在 secrets/restic_password，请离线保存一份）
# ---------------------------------------------------------------------
# 备份目标：local（本地另一块硬盘）| s3（阿里云 OSS / 腾讯云 COS 等 S3 兼容存储）
HV_BACKUP_TARGET=local
# 本地备份仓库路径（应位于另一块物理硬盘），例如 /mnt/backup/homevault-restic
HV_BACKUP_LOCAL_PATH=
# S3 仓库地址，例如 s3:https://oss-cn-hangzhou.aliyuncs.com/bucket/homevault
HV_BACKUP_S3_REPO=
# S3 额外参数，例如 '-o s3.bucket-lookup=dns -o s3.region=oss-cn-hangzhou'（密钥在 secrets/backup.env）
HV_BACKUP_S3_OPTIONS=
# 保留策略：每日 / 每周 / 每月 快照数量
HV_BACKUP_KEEP_DAILY=7
HV_BACKUP_KEEP_WEEKLY=4
HV_BACKUP_KEEP_MONTHLY=12
# 每日自动备份时间（24 小时制）
HV_BACKUP_TIME=03:30

# ---------------------------------------------------------------------
# 硬盘健康监控（Scrutiny，可选，仅 Linux）
# ---------------------------------------------------------------------
# 是否启用硬盘健康监控（true / false）
HV_MONITOR_ENABLED=false
# 网页端口（只在本机 127.0.0.1 上可访问）
HV_SCRUTINY_PORT=8080
# 要监控的硬盘设备（空格分隔），例如 '/dev/sda /dev/nvme0'；修改后运行 ./hv up（写入 compose.storage.yaml）
HV_SCRUTINY_DEVICES=

# ---------------------------------------------------------------------
# 镜像（完整地址；国内网络可由 hv install --mirror 改为镜像站前缀）
# ---------------------------------------------------------------------
# Nextcloud：一次只能升级一个大版本（34 → 35 → 36）
NEXTCLOUD_IMAGE=docker.io/library/nextcloud:34-apache
# PostgreSQL 18：数据卷挂载在 /var/lib/postgresql
POSTGRES_IMAGE=docker.io/library/postgres:18-alpine
REDIS_IMAGE=docker.io/library/redis:8-alpine
CADDY_IMAGE=docker.io/library/caddy:2.11.4-alpine
# 域名模式构建带 DNS 插件的 Caddy 时使用的构建镜像
CADDY_BUILDER_IMAGE=docker.io/library/caddy:2.11.4-builder
# 不要使用 latest（那是 v14）
WG_EASY_IMAGE=ghcr.io/wg-easy/wg-easy:15
RESTIC_IMAGE=docker.io/restic/restic:0.19.1
DDNS_GO_IMAGE=docker.io/jeessy/ddns-go:v6.17.7
SCRUTINY_IMAGE=ghcr.io/analogj/scrutiny:v0.9.4-omnibus
# 管理面板：在本机由 panel/Dockerfile 构建（不从任何镜像仓库拉取）
PANEL_IMAGE=homevault/panel:1.0.0
# Docker API 过滤代理（只供管理面板使用，只放行查看状态/日志与重启容器）
SOCKET_PROXY_IMAGE=docker.io/linuxserver/socket-proxy:3.4.5-r0-ls99
# 构建 Caddy 时的 Go 模块代理（国内可用 https://goproxy.cn,direct）
HV_GOPROXY=https://proxy.golang.org,direct
# 当前使用的镜像站前缀（由 hv install --mirror 写入，以 / 结尾；留空 = 直接使用 docker.io / ghcr.io）
# Docker Hub 镜像前缀，例如 docker.m.daocloud.io/（也用于构建管理面板时拉取 Go 构建镜像）
HV_MIRROR_HUB=
# ghcr.io 镜像前缀，例如 ghcr.m.daocloud.io/
HV_MIRROR_GHCR=

# ---------------------------------------------------------------------
# 安卓 App
# ---------------------------------------------------------------------
# 下载安卓 App 安装包的 GitHub 仓库（./hv android fetch 从它的最新 Release 下载 APK，供手机在局域网内安装）
HV_ANDROID_RELEASE_REPO=yuelanxian/-
