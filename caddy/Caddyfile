# HomeVault Caddy 主配置 — 由 compose 的环境变量填充 {$VAR} 占位符（解析时替换）。
# 修改后重载：docker compose kill -s USR1 caddy（admin off 时仍有效）。
# 注意：环境变量只在容器创建时注入；改 .env 后需 `hv up` 重建 caddy 容器。
{
	admin off
	persist_config off
	skip_install_trust
	http_port {$HV_HTTP_PORT}
	# 故意不设置 https_port：站点地址已带端口；若 https_port 等于站点端口，
	# Caddy 的 HTTP→HTTPS 跳转会省略端口（HV_HTTPS_PORT≠443 时跳转到错误地址）。
	servers {
		# 仅 TCP：不启用 HTTP/3（不发布 UDP 端口）
		protocols h1 h2
	}
	pki {
		ca local {
			name "HomeVault Local CA"
		}
	}
	# 证书来源：internal（本地 CA）或 acme-<dns 服务商>（DNS-01，需 compose.acme.yaml 构建的镜像）
	import snippets/tls-{$HV_TLS_SNIPPET}.caddy
}

# 访问日志：宿主机 HV_LOG_DIR/caddy/access.log（JSON 行；Cookie/Authorization 等敏感请求头自动脱敏）。
# 超过 50 MiB 滚动为压缩文件，保留 HV_LOG_RETENTION_DAYS 天；每日维护任务也会按天数清理。
# mode 0640：配合宿主机日志目录的默认 ACL，管理面板（uid 65532）可以只读查看。
(access_log) {
	log {
		output file /var/log/homevault/caddy/access.log {
			mode 0640
			roll_size 50MiB
			roll_keep 20
			roll_keep_for {$HV_LOG_RETENTION_DAYS}d
			roll_local_time
		}
		format json
	}
}

{$HV_SITE_ADDRESSES} {
	import access_log

	# route 保证按书写顺序执行：abort 必须先于 redir
	route {
		@outside not remote_ip {$HV_ALLOWED_CIDRS}
		abort @outside

		header Strict-Transport-Security "max-age=15552000"
		header -Server
		header -X-Powered-By

		redir /.well-known/carddav /remote.php/dav/ 301
		redir /.well-known/caldav /remote.php/dav/ 301

		# 不限制请求体大小、不缓冲：多 GB 视频直接流式转发给 Nextcloud
		reverse_proxy app:80 {
			transport http {
				keepalive 4s
			}
		}
	}
}

# 管理面板（安卓 App / 浏览器）：https://HV_HOST:HV_PANEL_PORT，与主站共用证书和来源 IP 过滤。
# 面板自身要求 Nextcloud 管理员登录（含两步验证）。
https://{$HV_HOST}:{$HV_PANEL_PORT} {
	import access_log

	route {
		@outside not remote_ip {$HV_ALLOWED_CIDRS}
		abort @outside

		header Strict-Transport-Security "max-age=15552000"
		header -Server

		reverse_proxy panel:8080
	}
}

# wg-easy 管理界面（Linux + VPN 时为 wg-easy，其余为空）
import snippets/admin-{$HV_ADMIN_SNIPPET}.caddy
