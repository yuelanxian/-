# 域名模式（阿里云 DNS）：Let's Encrypt DNS-01 验证，无需开放 80/443。
# 凭据文件（compose.acme.yaml 只读挂载 secrets/caddy-dns/，启动时读取，不经过环境变量）：
# secrets/caddy-dns/ALIYUN_ACCESS_KEY_ID、secrets/caddy-dns/ALIYUN_ACCESS_KEY_SECRET。
cert_issuer acme {
	# "email <邮箱>" 或空（HV_ACME_EMAIL 留空时不登记邮箱；由 compose 生成，空的 email 指令会让 Caddy 无法启动）
	{$HV_ACME_EMAIL_DIRECTIVE}
	disable_http_challenge
	disable_tlsalpn_challenge
	dns alidns {
		access_key_id {file./run/secrets/caddy-dns/ALIYUN_ACCESS_KEY_ID}
		access_key_secret {file./run/secrets/caddy-dns/ALIYUN_ACCESS_KEY_SECRET}
	}
	resolvers 223.5.5.5 119.29.29.29
	propagation_delay 30s
	propagation_timeout 10m
}
