# 域名模式（Cloudflare）：Let's Encrypt DNS-01 验证，无需开放 80/443。
# 凭据来自 secrets/caddy-dns.env：CF_API_TOKEN（Zone.Zone:Read + Zone.DNS:Edit，仅限该域名）。
cert_issuer acme {
	email {$HV_ACME_EMAIL}
	disable_http_challenge
	disable_tlsalpn_challenge
	dns cloudflare {env.CF_API_TOKEN}
	resolvers 223.5.5.5 119.29.29.29
	propagation_delay 30s
	propagation_timeout 10m
}
